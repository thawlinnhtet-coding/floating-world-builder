{
  "name": "floating-world-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "check": "tsc -b",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "db:migrate:local": "wrangler d1 migrations apply floating-worlds --local",
    "worker:types": "wrangler types",
    "test": "playwright test",
    "test:browser": "playwright test tests/game.spec.ts",
    "test:api": "playwright test tests/api.spec.ts",
    "db:migrate:test": "wrangler d1 migrations apply floating-worlds --local --persist-to .wrangler/test-state",
    "deploy": "npm run build && wrangler deploy --config dist/worker/wrangler.json"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "idb": "^8.0.0",
    "lucide-react": "latest",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "wrangler": "^4.151.0"
  }
}
